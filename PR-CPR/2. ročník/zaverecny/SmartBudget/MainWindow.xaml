<Window x:Class="SmartBudget.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:SmartBudget.Helpers"
        Title="SmartBudget" Height="600" Width="900"
        WindowStartupLocation="CenterScreen">

    <Grid Background="{DynamicResource WindowBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="220"/>
        </Grid.ColumnDefinitions>

        <!-- Navbar -->
        <Border Grid.Row="0" Grid.ColumnSpan="3" Background="{DynamicResource NavbarBackground}">
            <Grid Margin="16,0">
                <TextBlock Text="SmartBudget" Foreground="{DynamicResource NavbarText}"
                           FontSize="18" FontWeight="Bold" VerticalAlignment="Center"
                           HorizontalAlignment="Left"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <TextBlock Text="{Binding CurrentUsername}"
                               Foreground="{DynamicResource NavbarSubText}"
                               FontSize="13" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <Button Content="🌙 Tmavý režim" Click="ToggleTheme_Click"
                            Background="#34495E" Foreground="White"
                            BorderThickness="0" Padding="12,6"
                            FontSize="12" Margin="0,0,8,0"/>
                    <Button Content="Odhlásit" Command="{Binding LogoutCommand}"
                            Background="#E74C3C" Foreground="White"
                            BorderThickness="0" Padding="14,6"
                            FontSize="12"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Vlevo: příjmy -->
        <Border Grid.Row="1" Grid.Column="0"
                Background="{DynamicResource LeftPanelBackground}" Margin="8">
            <StackPanel Margin="12">
                <TextBlock Text="Příjmy" FontSize="14" FontWeight="Bold"
                           Foreground="{DynamicResource PrimaryText}" Margin="0,0,0,8"/>
                <ItemsControl ItemsSource="{Binding Transactions}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Margin="0,2" FontSize="12">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Type}" Value="Income">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Setter Property="Text" Value="{Binding Amount, StringFormat='+{0:N0} Kč'}"/>
                                                <Setter Property="Foreground" Value="#27AE60"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- Střed: balance + formulář + seznam -->
        <ScrollViewer Grid.Row="1" Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="8" VerticalAlignment="Top">

                <!-- Balance -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="{DynamicResource CardBackground}"
                            Padding="12,8" BorderBrush="{DynamicResource BorderColor}"
                            BorderThickness="1,1,0,1">
                        <StackPanel>
                            <TextBlock Text="Zůstatek" FontSize="11"
                                       Foreground="{DynamicResource SecondaryText}"/>
                            <TextBlock Text="{Binding Balance, StringFormat='{}{0:N0} Kč'}"
                                       FontSize="22" FontWeight="Bold"
                                       Foreground="{DynamicResource PrimaryText}"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Background="{DynamicResource CardBackground}"
                            Padding="12,8" BorderBrush="{DynamicResource BorderColor}"
                            BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Výdaje tento měsíc" FontSize="11"
                                       Foreground="{DynamicResource SecondaryText}"/>
                            <TextBlock Text="{Binding MonthlyExpenses, StringFormat='{}{0:N0} Kč'}"
                                       FontSize="22" FontWeight="Bold"
                                       Foreground="{DynamicResource ExpenseColor}"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Formulář nové transakce -->
                <Border Background="{DynamicResource CardBackground}" Padding="16"
                        BorderBrush="{DynamicResource BorderColor}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Nová transakce" FontSize="14" FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryText}" Margin="0,0,0,12"/>

                        <TextBlock Text="Částka (Kč)" Margin="0,0,0,4" FontSize="12"
                                   Foreground="{DynamicResource PrimaryText}"/>
                        <TextBox Text="{Binding NewAmount, UpdateSourceTrigger=PropertyChanged}"
                                 Height="32" Padding="8,0"
                                 BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                                 Background="{DynamicResource InputBackground}"
                                 Foreground="{DynamicResource PrimaryText}"/>

                        <TextBlock Text="Poznámka" Margin="0,10,0,4" FontSize="12"
                                   Foreground="{DynamicResource PrimaryText}"/>
                        <TextBox Text="{Binding NewNote, UpdateSourceTrigger=PropertyChanged}"
                                 Height="32" Padding="8,0"
                                 BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                                 Background="{DynamicResource InputBackground}"
                                 Foreground="{DynamicResource PrimaryText}"/>

                        <TextBlock Text="Kategorie" Margin="0,10,0,4" FontSize="12"
                                   Foreground="{DynamicResource PrimaryText}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <ComboBox Grid.Column="0"
                                      ItemsSource="{Binding Categories}"
                                      SelectedItem="{Binding SelectedCategory}"
                                      DisplayMemberPath="Name"
                                      Height="32" Padding="8,0"
                                      BorderBrush="{DynamicResource BorderColor}"
                                      Background="{DynamicResource InputBackground}"/>

                            <Button Grid.Column="1" Content="🗑"
                                    Command="{Binding DeleteCategoryCommand}"
                                    CommandParameter="{Binding SelectedCategory}"
                                    Height="32" Width="32" Margin="4,0,0,0"
                                    Background="{DynamicResource ExpenseColor}" Foreground="White"
                                    BorderThickness="0" FontSize="13"
                                    ToolTip="Smazat vybranou kategorii"/>

                            <TextBox Grid.Column="2"
                                     Text="{Binding NewCategoryName, UpdateSourceTrigger=PropertyChanged}"
                                     Height="32" Width="100" Padding="8,0" Margin="4,0"
                                     BorderBrush="{DynamicResource BorderColor}"
                                     Background="{DynamicResource InputBackground}"
                                     Foreground="{DynamicResource PrimaryText}"/>

                            <Button Grid.Column="3" Content="+ Přidat"
                                    Command="{Binding AddCategoryCommand}"
                                    Height="32" Padding="8,0"
                                    Background="{DynamicResource AccentBlue}" Foreground="White"
                                    BorderThickness="0" FontSize="11"/>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <RadioButton Content="Příjem" IsChecked="{Binding IsIncome}"
                                         Foreground="{DynamicResource IncomeColor}"
                                         Margin="0,0,16,0"/>
                            <RadioButton Content="Výdaj"
                                         IsChecked="{Binding IsIncome, Converter={StaticResource InverseBoolConverter}}"
                                         Foreground="{DynamicResource ExpenseColor}"/>
                        </StackPanel>

                        <TextBlock Text="{Binding ErrorMessage}"
                                   Foreground="{DynamicResource ExpenseColor}"
                                   FontSize="12" Margin="0,6,0,0"/>

                        <Button Content="Přidat transakci" Height="36" Margin="0,12,0,0"
                                Background="{DynamicResource AccentGreen}" Foreground="White"
                                FontWeight="SemiBold" BorderThickness="0"
                                Command="{Binding AddTransactionCommand}"/>
                    </StackPanel>
                </Border>

                <!-- Seznam transakcí -->
                <Border Background="{DynamicResource CardBackground}" Padding="16"
                        BorderBrush="{DynamicResource BorderColor}"
                        BorderThickness="1" Margin="0,12,0,0">
                    <StackPanel>
                        <StackPanel Margin="0,0,0,12">
                            <DockPanel Margin="0,0,0,8">
                                <TextBlock Text="Historie transakcí" FontSize="14" FontWeight="Bold"
                                           Foreground="{DynamicResource PrimaryText}"
                                           VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="Vše" Command="{Binding FilterAllCommand}"
                                            Background="{DynamicResource AccentBlue}" Foreground="White"
                                            BorderThickness="0" Padding="10,4" FontSize="11" Margin="0,0,4,0"/>
                                    <Button Content="Příjmy" Command="{Binding FilterIncomeCommand}"
                                            Background="{DynamicResource IncomeColor}" Foreground="White"
                                            BorderThickness="0" Padding="10,4" FontSize="11" Margin="0,0,4,0"/>
                                    <Button Content="Výdaje" Command="{Binding FilterExpenseCommand}"
                                            Background="{DynamicResource ExpenseColor}" Foreground="White"
                                            BorderThickness="0" Padding="10,4" FontSize="11"/>
                                </StackPanel>
                            </DockPanel>

                            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     Height="30" Padding="8,0"
                                     BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                                     Background="{DynamicResource InputBackground}"
                                     Foreground="{DynamicResource PrimaryText}">
                                <TextBox.Style>
                                    <Style TargetType="TextBox">
                                        <Style.Resources>
                                            <VisualBrush x:Key="HintBrush" TileMode="None" Stretch="None" AlignmentX="Left">
                                                <VisualBrush.Visual>
                                                    <TextBlock Text="🔍 Hledat v poznámkách..."
                                                               Foreground="{DynamicResource SecondaryText}"
                                                               FontSize="12" Margin="2,0"/>
                                                </VisualBrush.Visual>
                                            </VisualBrush>
                                        </Style.Resources>
                                        <Style.Triggers>
                                            <Trigger Property="Text" Value="">
                                                <Setter Property="Background" Value="{StaticResource HintBrush}"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>
                        </StackPanel>

                        <ItemsControl ItemsSource="{Binding FilteredTransactions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource SeparatorColor}"
                                            BorderThickness="0,0,0,1" Padding="0,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding Note}" FontSize="13"
                                                           Foreground="{DynamicResource PrimaryText}"/>
                                                <TextBlock Text="{Binding Date, StringFormat='{}{0:dd.MM.yyyy}'}"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource SecondaryText}"/>
                                                <TextBlock FontSize="11"
                                                           Foreground="{DynamicResource AccentBlue}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Category}" Value="{x:Null}">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                    <Run Text="📁 "/>
                                                    <Run Text="{Binding Category.Name}"/>
                                                </TextBlock>
                                            </StackPanel>

                                            <TextBlock Grid.Column="1" VerticalAlignment="Center"
                                                       Margin="8,0" FontSize="13" FontWeight="SemiBold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Type}" Value="Income">
                                                                <Setter Property="Text" Value="{Binding Amount, StringFormat='+{0:N0} Kč'}"/>
                                                                <Setter Property="Foreground" Value="#27AE60"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Type}" Value="Expense">
                                                                <Setter Property="Text" Value="{Binding Amount, StringFormat='-{0:N0} Kč'}"/>
                                                                <Setter Property="Foreground" Value="#E74C3C"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>

                                            <Button Grid.Column="2" Content="✕"
                                                    Background="Transparent"
                                                    Foreground="{DynamicResource ExpenseColor}"
                                                    BorderThickness="0" FontSize="14"
                                                    VerticalAlignment="Center"
                                                    Command="{Binding DataContext.DeleteTransactionCommand,
                                                              RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Vpravo: výdaje -->
        <Border Grid.Row="1" Grid.Column="2"
                Background="{DynamicResource RightPanelBackground}" Margin="8">
            <StackPanel Margin="12">
                <TextBlock Text="Výdaje" FontSize="14" FontWeight="Bold"
                           Foreground="{DynamicResource PrimaryText}" Margin="0,0,0,8"/>
                <ItemsControl ItemsSource="{Binding Transactions}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Margin="0,2" FontSize="12">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Type}" Value="Expense">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Setter Property="Text" Value="{Binding Amount, StringFormat='-{0:N0} Kč'}"/>
                                                <Setter Property="Foreground" Value="#E74C3C"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

    </Grid>
</Window>