<Window x:Class="SmartBudget.Views.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SmartBudget – Registrace"
        Height="420" Width="420"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Grid Background="{DynamicResource WindowBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource NavbarBackground}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="SmartBudget" Foreground="{DynamicResource NavbarText}"
                           FontSize="22" FontWeight="Bold" HorizontalAlignment="Center"/>
                <TextBlock Text="Vytvoření nového účtu"
                           Foreground="{DynamicResource NavbarSubText}"
                           FontSize="11" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="1" Width="300" VerticalAlignment="Center"
                    HorizontalAlignment="Center">

            <TextBlock Text="Uživatelské jméno" Margin="0,0,0,4"
                       Foreground="{DynamicResource PrimaryText}" FontSize="12"/>
            <TextBox x:Name="UsernameBox"
                     Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                     Height="36" Padding="10,0" FontSize="13"
                     BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                     Background="{DynamicResource InputBackground}"
                     Foreground="{DynamicResource PrimaryText}"/>

            <TextBlock Text="Heslo (min. 4 znaky)" Margin="0,12,0,4"
                       Foreground="{DynamicResource PrimaryText}" FontSize="12"/>
            <PasswordBox x:Name="PasswordBox"
                         Height="36" Padding="10,0" FontSize="13"
                         BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                         Background="{DynamicResource InputBackground}"/>

            <TextBlock Text="{Binding ErrorMessage}"
                       Foreground="{DynamicResource ExpenseColor}"
                       Margin="0,8,0,0" FontSize="12" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding SuccessMessage}"
                       Foreground="{DynamicResource IncomeColor}"
                       Margin="0,4,0,0" FontSize="12" TextWrapping="Wrap"/>

            <Button Content="Zaregistrovat se" Height="40" Margin="0,16,0,0"
                    Background="{DynamicResource AccentBlue}" Foreground="White"
                    FontSize="13" FontWeight="Bold" BorderThickness="0"
                    Click="RegisterButton_Click"/>

            <Button Content="Zpět na přihlášení" Height="34" Margin="0,6,0,0"
                    Background="Transparent" Foreground="{DynamicResource SecondaryText}"
                    FontSize="12" BorderThickness="0"
                    Command="{Binding NavigateToLoginCommand}"/>
        </StackPanel>
    </Grid>
</Window>